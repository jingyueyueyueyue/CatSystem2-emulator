<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <application android:label="CatSystem2 Player"
        android:theme="@android:style/Theme.Material.NoActionBar"
        android:allowBackup="false" android:supportsRtl="true" android:requestLegacyExternalStorage="true">
        <provider android:name=".PlayerActivity$GameFilesProvider"
            android:authorities="${applicationId}.gamefiles"
            android:exported="false" android:grantUriPermissions="true" />
        <activity android:name=".PlayerActivity" android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:screenOrientation="sensorLandscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".TweetActivity" android:exported="false"
            android:excludeFromRecents="true" />
    </application>
</manifest>
